import math
from collections import Counter, defaultdict
import nltk
from nltk.tokenize import word_tokenize

# Download tokenizer dependencies
nltk.download('punkt', quiet=True)


class NGramSmoothedModel:
    def __init__(self, corpus, n=2):
        self.n = n
        self.unigram_counts = Counter()
        self.ngram_counts = Counter()
        self.context_counts = Counter()
        self.vocab = set()
        
        # Preprocessing & building frequency tables
        self._build_counts(corpus)
        self.vocab_size = len(self.vocab)

    def _build_counts(self, corpus):
        tokens = word_tokenize(corpus.lower())
        self.vocab = set(tokens)
        self.unigram_counts.update(tokens)

        # Generate N-grams
        for i in range(len(tokens) - self.n + 1):
            ngram = tuple(tokens[i : i + self.n])
            context = ngram[:-1]
            self.ngram_counts[ngram] += 1
            self.context_counts[context] += 1

    # 1. Laplace (Add-1) Smoothing
    def laplace_probability(self, word, context):
        """P(w | context) = (C(context, w) + 1) / (C(context) + |V|)"""
        ngram = context + (word,)
        count_ngram = self.ngram_counts[ngram]
        count_context = self.context_counts[context]

        return (count_ngram + 1) / (count_context + self.vocab_size)

    # 2. Add-k Smoothing
    def add_k_probability(self, word, context, k=0.5):
        """P(w | context) = (C(context, w) + k) / (C(context) + k * |V|)"""
        ngram = context + (word,)
        count_ngram = self.ngram_counts[ngram]
        count_context = self.context_counts[context]

        return (count_ngram + k) / (count_context + (k * self.vocab_size))

    # 3. Interpolated Absolute Discounting / Kneser-Ney (Bigram Simplified)
    def kneser_ney_probability(self, word, context, d=0.75):
        """Simplified Absolute Discounting with Kneser-Ney Continuation Probability"""
        if len(context) != 1:
            raise ValueError("Kneser-Ney simplified implementation supports bigrams (context length 1).")

        ngram = context + (word,)
        count_ngram = self.ngram_counts[ngram]
        count_context = self.context_counts[context]

        # Continuation Probability: how many unique preceding words lead to 'word'
        num_preceding_contexts = sum(1 for (w1, w2) in self.ngram_counts.keys() if w2 == word)
        total_unique_bigrams = len(self.ngram_counts)
        p_continuation = num_preceding_contexts / total_unique_bigrams

        if count_context > 0:
            # Discounted Highest-Order Term
            highest_order = max(count_ngram - d, 0) / count_context
            
            # Interpolation Weight (Lambda)
            num_unique_following = sum(1 for (w1, w2) in self.ngram_counts.keys() if w1 == context[0])
            lambda_weight = (d / count_context) * num_unique_following
            
            return highest_order + (lambda_weight * p_continuation)
        else:
            return p_continuation


