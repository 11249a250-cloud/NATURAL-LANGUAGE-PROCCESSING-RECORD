import string
import nltk
from nltk.corpus import stopwords
from nltk.tokenize import word_tokenize
from nltk.probability import FreqDist
from nltk.stem import PorterStemmer, WordNetLemmatizer

nltk.download('punkt', quiet=True)
nltk.download('stopwords', quiet=True)
nltk.download('wordnet', quiet=True)

def analyze_words(text):
    print("=== ORIGINAL TEXT ===")
    print(text)
    print("\n" + "="*40 + "\n")

    tokens = word_tokenize(text)
    
    words = [word.lower() for word in tokens if word.isalnum()]
    
    total_words = len(words)
    unique_words = set(words)
    vocab_richness = (len(unique_words) / total_words) * 100 if total_words > 0 else 0

    print("=== BASIC WORD METRICS ===")
    print(f"Total Words (Tokens): {total_words}")
    print(f"Unique Words (Types): {len(unique_words)}")
    print(f"Vocabulary Richness (TTR): {vocab_richness:.2f}%")
    print("\n" + "="*40 + "\n")

    # 2. Stop-word Removal
    stop_words = set(stopwords.words('english'))
    filtered_words = [w for w in words if w not in stop_words]

    print("=== STOP-WORD FILTERING ===")
    print(f"Words remaining after removing stop-words: {len(filtered_words)}")
    print(f"Sample filtered words: {filtered_words[:10]}")
    print("\n" + "="*40 + "\n")

    # 3. Frequency Analysis
    fdist = FreqDist(filtered_words)
    print("=== TOP 5 MOST COMMON WORDS ===")
    for word, count in fdist.most_common(5):
        print(f"'{word}': {count} time(s)")
    print("\n" + "="*40 + "\n")

    # 4. Stemming vs. Lemmatization
    stemmer = PorterStemmer()
    lemmatizer = WordNetLemmatizer()

    print("=== STEMMING & LEMMATIZATION COMPARISON ===")
    print(f"{'Original':<15} | {'Stemmed':<15} | {'Lemmatized':<15}")
    print("-" * 50)
    
    # Demonstrate on unique words from the text
    for word in list(unique_words)[:8]:
        stemmed = stemmer.stem(word)
        lemmatized = lemmatizer.lemmatize(word)
        print(f"{word:<15} | {stemmed:<15} | {lemmatized:<15}")

# Sample input text
sample_text = """
Natural language processing (NLP) is a subfield of linguistics, computer science, and artificial intelligence 
concerned with the interactions between computers and human language. NLP researchers analyze how machines 
can process and analyze large amounts of natural language data effectively.
"""

if __name__ == "__main__":
    analyze_words(sample_text)

